{{! Expiry notice plus the raw link, in the app's sunk panel. }}
<p
  style='margin: 24px 0 8px 0; font-size: 12px; line-height: 1.6; color: #5B5D63;'
>
  This link expires in
  <strong style='color: #12161F;'>{{expiresIn}}</strong>.
  If the button does not work, copy this link into your browser:
</p>

<div
  style='padding: 10px 12px; background-color: #F1EEE9; border: 1px solid #E7E4DF; border-radius: 10px; font-size: 12px; line-height: 1.5; color: #FC425D; word-break: break-all;'
>
  {{url}}
</div>
